{
  "meta": {
    "name": "hernanyacosta-dark-system",
    "version": "1.0.0"
  },
  "breakpoints": {
    "bpMobile": "0px",
    "bpTablet": "768px",
    "bpDesktop": "1024px",
    "bpWide": "1440px"
  },
  "colors": {
    "backgroundPrimary": "#0B0B0D",
    "backgroundDeep": "#08090F",
    "backgroundSecondary": "#111114",
    "surfaceElevated": "#1A1A1F",

    "textPrimary": "#FFFFFF",
    "textSecondary": "rgba(255,255,255,0.72)",
    "textMuted": "rgba(255,255,255,0.48)",

    "borderSubtle": "rgba(255,255,255,0.08)",
    "borderSoft": "rgba(255,255,255,0.12)",
    "dividerSubtle": "rgba(255,255,255,0.12)",

    "accent500": "#6C63FF",
    "accent600": "#5A52E8",
    "accent100": "rgba(108,99,255,0.12)",
    "accent200": "rgba(108,99,255,0.20)",
    "accentGlow": "rgba(108,99,255,0.35)"
  },
  "spacing": {
    "s4": "4px",
    "s8": "8px",
    "s12": "12px",
    "s16": "16px",
    "s24": "24px",
    "s32": "32px",
    "s48": "48px",
    "s64": "64px",
    "s80": "80px",
    "s96": "96px",
    "s120": "120px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "20px",
    "pill": "999px"
  },
  "shadows": {
    "soft": "0 8px 24px rgba(0,0,0,0.40)",
    "accentGlow": "0 0 40px rgba(108,99,255,0.35)"
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial"
    },
    "textH1": {
      "desktop": { "size": "48px", "lineHeight": "56px", "weight": 600, "letterSpacing": "-0.02em" },
      "mobile": { "size": "32px", "lineHeight": "40px", "weight": 600, "letterSpacing": "-0.02em" }
    },
    "textH2": {
      "desktop": { "size": "32px", "lineHeight": "40px", "weight": 600, "letterSpacing": "-0.01em" },
      "mobile": { "size": "24px", "lineHeight": "32px", "weight": 600, "letterSpacing": "-0.01em" }
    },
    "textH3": {
      "desktop": { "size": "20px", "lineHeight": "28px", "weight": 500, "letterSpacing": "0em" },
      "mobile": { "size": "18px", "lineHeight": "24px", "weight": 500, "letterSpacing": "0em" }
    },
    "textBodyLg": {
      "desktop": { "size": "18px", "lineHeight": "28px", "weight": 400, "letterSpacing": "0em" },
      "mobile": { "size": "16px", "lineHeight": "24px", "weight": 400, "letterSpacing": "0em" }
    },
    "textBodyMd": {
      "desktop": { "size": "16px", "lineHeight": "24px", "weight": 400, "letterSpacing": "0em" },
      "mobile": { "size": "15px", "lineHeight": "22px", "weight": 400, "letterSpacing": "0em" }
    },
    "textMicro": {
      "desktop": { "size": "12px", "lineHeight": "16px", "weight": 400, "letterSpacing": "0.08em" },
      "mobile": { "size": "12px", "lineHeight": "16px", "weight": 400, "letterSpacing": "0.08em" }
    }
  },
  "layout": {
    "containerMaxWidth": "1200px",
    "containerPaddingDesktop": "0 48px",
    "containerPaddingMobile": "0 24px",
    "sectionSpacingDesktop": "120px",
    "sectionSpacingMobile": "80px",
    "gridColumns": 12,
    "gridGapDesktop": "32px",
    "gridGapMobile": "24px"
  },
  "components": {
    "divider": {
      "height": "1px",
      "color": "{colors.dividerSubtle}",
      "widthShort": "120px"
    },
    "button": {
      "height": "48px",
      "paddingX": "24px",
      "radius": "{radius.pill}",
      "font": "textBodyMd",
      "primary": {
        "bg": "{colors.accent500}",
        "color": "{colors.textPrimary}",
        "shadow": "{shadows.accentGlow}"
      },
      "secondary": {
        "bg": "transparent",
        "border": "1px solid rgba(255,255,255,0.16)",
        "color": "{colors.textPrimary}"
      },
      "ghost": {
        "bg": "rgba(255,255,255,0.04)",
        "border": "1px solid rgba(255,255,255,0.12)",
        "color": "{colors.textPrimary}"
      }
    },
    "iconButton": {
      "size": "48px",
      "radius": "{radius.pill}",
      "bg": "{colors.accent500}",
      "color": "{colors.textPrimary}",
      "shadow": "{shadows.accentGlow}",
      "back": {
        "size": "40px",
        "bg": "{colors.accent500}",
        "color": "{colors.textPrimary}"
      }
    },
    "tag": {
      "bg": "{colors.accent100}",
      "color": "{colors.accent500}",
      "padding": "4px 12px",
      "radius": "{radius.pill}",
      "font": "textMicro"
    },
    "card": {
      "bg": "{colors.backgroundSecondary}",
      "border": "1px solid rgba(255,255,255,0.08)",
      "radius": "{radius.md}",
      "paddingDesktop": "32px",
      "paddingMobile": "24px"
    },
    "menu": {
      "overlayBg": "rgba(8,9,15,0.96)",
      "itemFont": "textH2",
      "itemColor": "{colors.textSecondary}",
      "itemActiveColor": "{colors.accent500}",
      "toggleBg": "rgba(255,255,255,0.06)",
      "toggleActiveBg": "{colors.accent500}",
      "toggleRadius": "{radius.pill}"
    },
    "segmentedControl": {
      "containerBg": "rgba(255,255,255,0.03)",
      "containerBorder": "1px solid rgba(255,255,255,0.10)",
      "containerRadius": "{radius.pill}",
      "containerPadding": "6px",
      "itemPadding": "10px 16px",
      "itemRadius": "{radius.pill}",
      "itemFont": "textBodyMd",
      "itemColor": "{colors.textMuted}",
      "itemActiveBg": "{colors.accent500}",
      "itemActiveColor": "{colors.textPrimary}"
    },
    "statPill": {
      "bg": "rgba(255,255,255,0.04)",
      "border": "1px solid rgba(255,255,255,0.10)",
      "radius": "{radius.pill}",
      "paddingDesktop": "14px 18px",
      "paddingMobile": "12px 16px",
      "labelFont": "textMicro",
      "labelColor": "{colors.textMuted}",
      "valueFont": "textBodyMd",
      "valueColor": "{colors.textSecondary}",
      "dividerColor": "rgba(255,255,255,0.10)"
    }
  }
}
